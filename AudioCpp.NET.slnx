  <!--
    Asset-only packages: they compile nothing and exist to carry the prebuilt native
    shims. Listed so the repository structure is self-describing and so a plain build
    validates them; packing them requires staged shims (see eng/packaging).
  -->
  <Folder Name="/packaging/">
    <Project Path="src/AudioCpp.NET.Runtime/AudioCpp.NET.Runtime.csproj" />
    <Project Path="src/AudioCpp.NET.Runtime.Cuda/AudioCpp.NET.Runtime.Cuda.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/AudioCpp.NET.Tests/AudioCpp.NET.Tests.csproj" />
  </Folder>
</Solution>
