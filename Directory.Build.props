<Project>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Package metadata shared by every packable project.

    VersionPrefix is the single source of truth for the released version. Release
    automation passes -p:Version=<tag> so the tag wins without editing this file.
  -->
  <PropertyGroup>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
    <Authors>dongfangzhizhu</Authors>
    <Product>AudioCpp.NET</Product>
    <Copyright>Copyright (c) 2026 AudioCpp.NET contributors</Copyright>

    <!--
      The native shim links the pinned audio.cpp engine, which is Apache-2.0
      (Copyright 2026 ShugoAI LLC). Apache-2.0 is inbound-compatible, so this
      repository and the binaries it redistributes stay Apache-2.0. See NOTICE.
    -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dongfangzhizhu/AudioCpp.NET</PackageProjectUrl>

    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/dongfangzhizhu/AudioCpp.NET.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PackageTags>audio;speech;asr;tts;vad;voice-clone;ggml;audio.cpp;native;interop</PackageTags>
  </PropertyGroup>

</Project>
