# Build output. The whole build/ tree is derived: CMake build trees
# (build/native-<backend>), the offline dependency cache (build/deps) and matrix
# test output (build/artifacts).
bin/
obj/
build/
artifacts/

# IDE state
.vs/
.vscode/
*.user
*.suo

# NuGet output (packages are produced by eng/packaging/pack.*)
*.nupkg
*.snupkg

# Python bytecode from the eng/ helper scripts
__pycache__/
*.py[cod]

# A GitHub token handed to eng/release/publish-github.py must never be committed
.github-token

# Pinned upstream checkouts and generated comparison reports
upstream/
upstream-*-report.md

# Downloaded model packages stay local: they are multi-GB and licensed separately
# from this repository. Reinstall with the console `models download` command.
/models/
